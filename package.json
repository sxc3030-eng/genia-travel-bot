{
  "name": "genia-travel-bot",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @genia/redirector",
    "build": "npm run build --workspaces --if-present",
    "migrate": "tsx packages/core/src/migrate.ts",
    "seed:test-offer": "npm run seed:test-offer -w @genia/linkbuilder",
    "scan": "npm run scan -w @genia/scanner",
    "creative:preview": "npm run creative:preview -w @genia/publisher",
    "test": "npm run test --workspaces --if-present",
    "verify:pipeline": "npm run verify:pipeline -w @genia/publisher",
    "analytics:import": "npm run import -w @genia/analytics",
    "analytics:report": "npm run report -w @genia/analytics",
    "analytics:verify": "npm run verify -w @genia/analytics"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
