DATABASE_URL=postgres://genia:genia@localhost:5432/genia_travel_bot
REDIS_URL=redis://localhost:6379

EXPEDIA_AFFILIATE_ID=
EXPEDIA_NETWORK=partnerize          # partnerize | impact
EXPEDIA_POS=CA

REDIRECT_BASE_URL=http://localhost:3000/go

# Decisions — plan section 7 (see docs/PLAN.md)
ORIGIN_AIRPORTS=YUL,YYZ             # #1 — comma-separated, first is the default route origin
GEO_SCOPE=north_america             # #2 — north_america | world
HUMAN_APPROVAL_REQUIRED=true        # #3 — posts wait in the approval queue before publishing
# PUBLISH_WINDOW_MIN/MAX_DAYS below = #4

# Phase 2 (Scanner) — first source, per decision #5. Get a key at
# https://developer.ticketmaster.com/ before starting Phase 2.
EVENT_SOURCE_PRIMARY=ticketmaster
TICKETMASTER_API_KEY=

META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_TOKEN=
IG_BUSINESS_ID=

MAX_POSTS_PER_DAY=4
PUBLISH_WINDOW_MIN_DAYS=21
PUBLISH_WINDOW_MAX_DAYS=56

# Optionnel : pousse les alertes vers Slack/Discord/etc. en plus de la table `alerts`
ALERT_WEBHOOK_URL=

PORT=3000
